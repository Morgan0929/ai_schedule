# ============ 数据库 ============
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_schedule_agent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123

# PostgreSQL 连接字符串（SQLAlchemy async）
DATABASE_URL=postgresql+asyncpg://postgres:postgres123@localhost:5432/ai_schedule_agent

# ============ Redis ============
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============ Qdrant ============
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# ============ DeepSeek ============
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ============ 服务端口 ============
APP_SERVICE_PORT=8000
CRAWLER_SERVICE_PORT=8001
AGENT_SERVICE_PORT=8002
TIMELINE_SERVICE_PORT=8003
RAG_SERVICE_PORT=8004

# ============ JWT ============
JWT_SECRET_KEY=change-me-to-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ============ 环境 ============
ENV=dev
LOG_LEVEL=INFO
